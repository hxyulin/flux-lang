struct Grid { cells: [u8; 6], width: usize }
fn index(&Grid, (usize, usize)) -> &u8
    self@0: &Grid
    row@1: usize
    col@2: usize
fn index_mut(&mut Grid, (usize, usize)) -> &mut u8
    self@0: &mut Grid
    row@1: usize
    col@2: usize
fn middle(&[i32]) -> &[i32]
    values@0: &[i32]
fn generic<C>(&C) -> i32
    c@0: &C
fn main() -> ()
    a@0: [i32; 5]
    b@1: &[i32]
    c@2: &[i32]
    d@3: &[i32]
    e@4: &[i32]
    f@5: &[i32]
    g@6: &[i32]
    first@7: i32
    len@8: usize
    m@9: &mut [i32]
    x@10: &mut i32
    mid@11: &[i32]
    grid@12: Grid
    corner@13: u8
    r@14: &mut u8
