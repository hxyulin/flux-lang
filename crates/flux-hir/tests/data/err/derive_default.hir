enum NoDefault { A = 0, B = 1 }

enum Two { A = 0, B = 1 }

enum WithFields { A(i32) = 0, B = 1 }

enum NotDerived { A = 0 }

enum Valued { A = 0 }

enum Fine { A = 0, B = 1 }

impl ::core::default::Default for Valued;

impl ::core::default::Default for Fine;

fn main() -> () {
    let _ = <Fine>::default();
    let _ = <Valued>::default();
}

fn <Valued as ::core::default::Default>::default() -> Self {
    Valued::A
}

fn <Fine as ::core::default::Default>::default() -> Self {
    Fine::B
}

