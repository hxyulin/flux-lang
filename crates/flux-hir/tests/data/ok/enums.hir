fn main() -> () {
    let _ = area(Shape::empty());
    let _ = Shape::Rect { w: 1, h: 2 }.sides();
    let _ = patterns(1, (true, 2), Maybe::Nothing);
    let _ = conditions(Maybe::Just(1), Maybe::Nothing);
    let _ = (Level::Mid as i32);
    let _ = (Level::Low == Level::High);
