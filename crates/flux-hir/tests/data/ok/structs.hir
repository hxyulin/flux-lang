struct Unit;

struct U;

struct Empty {  }

struct Point { x: i32, y: i32 }

struct Pair(i32, bool);

struct Line { start: Point, end: Point, width: u8 }

fn literals(x@0: i32) -> Line {
    let y@1 = 2;
    let start@2 = Point { x: x@0, y: y@1 };
    let end@3 = Point { x: 3, ..start@2 };
    let _unit@4 = Unit;
    let _braces@5 = Unit {  };
    let _empty@6 = Empty {  };
    let _pair@7 = Pair(1, true);
    let _named@8 = Pair { 0: 4, 1: false };
    Line { start: start@2, end: end@3, width: 1 }
}

fn access(line@0: Line, t@1: ((i32, u8), bool)) -> i32 {
    let a@2 = (line@0.start.x + line@0.end.y);
    let b@3 = t@1.0.1;
    let c@4 = t@1.0.0;
    let p@5 = Pair((a@2 + (line@0.width as i32)), t@1.1);
    if p@5.1 {
        ((a@2 + p@5.0) + c@4)
    } else {
        (b@3 as i32)
    }
}

fn patterns(line@0: Line, pair@1: Pair, triple@2: (i32, i32, i32)) -> i32 {
    let Line { start: start@3, end: Point { x: x@4, .. }, .. } = line@0;
    let Pair(n@5, _) = pair@1;
    let (first@6, ..) = triple@2;
    let (.., last@7) = triple@2;
    let (a@8, .., c@9) = triple@2;
    let Point { y: mut row@10, x: _ } = start@3;
    (row@10 += 1);
    let U = U;
    let Unit = Unit;
    ((((((x@4 + n@5) + first@6) + last@7) + a@8) + c@9) + row@10)
}

fn params(Point { x: x@0, y: y@1 }: Point, Pair(n@2, flag@3): Pair, (a@4, b@5): (i32, i32), Unit: Unit) -> i32 {
    if flag@3 {
        ((x@0 + y@1) + n@2)
    } else {
        (a@4 + b@5)
    }
}

fn nested((Pair(a@0, ..), Point { x: x@1, .. }): (Pair, Point)) -> i32 {
    (a@0 + x@1)
}

fn main() -> () {
    let line@0 = literals(1);
    let _ = access(line@0, ((1, 2), true));
    let _ = patterns(literals(2), Pair(3, false), (1, 2, 3));
    let _ = params(Point { x: 1, y: 2 }, Pair(3, true), (4, 5), Unit);
    let _ = nested((Pair(1, true), Point { x: 2, y: 3 }));
}

