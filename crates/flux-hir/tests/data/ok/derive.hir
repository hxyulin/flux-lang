struct Point { x: i32, y: i32 }

struct Tuple(u8, bool);

struct Unit;

struct Empty {  }

struct EmptyTuple();

struct Pair<T>(T, T);

struct Two<A, B> { a: A, b: B }

struct Split { inner: Point }

struct Square { side: u32 }

impl ::core::clone::Clone for Point;

impl ::core::marker::Copy for Point;

impl ::core::cmp::PartialEq for Point;

impl ::core::cmp::Eq for Point;

impl ::core::clone::Clone for Tuple;

impl ::core::cmp::PartialEq for Tuple;

impl ::core::clone::Clone for Unit;

impl ::core::marker::Copy for Unit;

impl ::core::cmp::PartialEq for Unit;

impl ::core::cmp::Eq for Unit;

impl ::core::clone::Clone for Empty;

impl ::core::cmp::PartialEq for Empty;

impl ::core::clone::Clone for EmptyTuple;

impl ::core::cmp::PartialEq for EmptyTuple;

impl<T> ::core::clone::Clone for Pair<T> where T: ::core::clone::Clone;

impl<T> ::core::marker::Copy for Pair<T> where T: ::core::marker::Copy;

impl<A, B> ::core::cmp::PartialEq for Two<A, B> where A: ::core::cmp::PartialEq, B: ::core::cmp::PartialEq;

impl<A, B> ::core::cmp::Eq for Two<A, B> where A: ::core::cmp::Eq, B: ::core::cmp::Eq;

impl ::core::clone::Clone for Split;

impl ::core::cmp::PartialEq for Split;

impl ::core::clone::Clone for Square;

impl ::core::marker::Copy for Square;

fn main() -> () {
    let p@0 = Point { x: 1, y: 2 };
    let _q@1 = (p@0.clone() == p@0);
    let _s@2 = Square { side: 3 }.clone();
}

fn <Point as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    assert_param_is_clone((&self@0.x));
    assert_param_is_clone((&self@0.y));
    (*self@0)
}

fn <Point as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    ((self@0.x == other@1.x) && (self@0.y == other@1.y))
}

fn <Point as ::core::cmp::Eq>::assert_receiver_is_total_eq(self@0: &Self) -> () {
    Eq::assert_receiver_is_total_eq((&self@0.x));
    Eq::assert_receiver_is_total_eq((&self@0.y));
}

fn <Tuple as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    Tuple { 0: Clone::clone((&self@0.0)), 1: Clone::clone((&self@0.1)) }
}

fn <Tuple as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    ((self@0.0 == other@1.0) && (self@0.1 == other@1.1))
}

fn <Unit as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    (*self@0)
}

fn <Unit as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    true
}

fn <Unit as ::core::cmp::Eq>::assert_receiver_is_total_eq(self@0: &Self) -> () {}

fn <Empty as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    Empty {  }
}

fn <Empty as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    true
}

fn <EmptyTuple as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    EmptyTuple {  }
}

fn <EmptyTuple as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    true
}

fn <Pair<T> as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    Pair { 0: Clone::clone((&self@0.0)), 1: Clone::clone((&self@0.1)) }
}

fn <Two<A, B> as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    ((self@0.a == other@1.a) && (self@0.b == other@1.b))
}

fn <Two<A, B> as ::core::cmp::Eq>::assert_receiver_is_total_eq(self@0: &Self) -> () {
    Eq::assert_receiver_is_total_eq((&self@0.a));
    Eq::assert_receiver_is_total_eq((&self@0.b));
}

fn <Split as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    Split { inner: Clone::clone((&self@0.inner)) }
}

fn <Split as ::core::cmp::PartialEq>::eq(self@0: &Self, other@1: &Self) -> bool {
    (self@0.inner == other@1.inner)
}

fn <Square as ::core::clone::Clone>::clone(self@0: &Self) -> Self {
    assert_param_is_clone((&self@0.side));
    (*self@0)
}

