fn Counter::into_n(self@0: Self) -> i32 {
    self@0.n
}

fn Counter::total(self@0: &Self, other@1: &Self) -> i32 {
    (self@0.get() + other@1.get())
}

fn Counter::copy_from(self@0: &mut Self, other@1: &Counter) -> () {
    (self@0.n = other@1.n);
    (self@0.step = (*other@1).step);
}

fn Counter::twice(self@0: &mut Self) -> () {
    self@0.bump();
    Counter::bump(self@0);
    Counter::bump(self@0);
}

fn Wrapper::make() -> Self {
    let inner@0 = Counter::new(2);
    Wrapper { inner: inner@0 }
