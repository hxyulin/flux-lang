fn main() -> () {
    {
        _print(Arguments::new_v1((&["", " ", " ", " ", " ", "\n"]), (&match ((&choose()), (&forms(0)), (&forms(1)), (&nested(0)), (&nested(1))) {
            args@0 => [Argument::new_display(args@0.0), Argument::new_display(args@0.1), Argument::new_display(args@0.2), Argument::new_display(args@0.3), Argument::new_display(args@0.4)],
