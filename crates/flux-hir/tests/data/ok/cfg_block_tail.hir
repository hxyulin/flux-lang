    14
}

fn <Trace as Drop>::drop(self@0: &mut Self) -> () {
    {
        _print(Arguments::new_v1((&["drop ", "\n"]), (&match ((&self@0.0),) {
            args@1 => [Argument::new_display(args@1.0)],
        })));
